<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-configuration PUBLIC
    "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
    "https://hibernate.org/dtd/hibernate-configuration-3.0.dtd">

<hibernate-configuration>

    <session-factory>

        <!-- Base de datos -->
        <property name="hibernate.connection.driver_class">
            com.mysql.cj.jdbc.Driver
        </property>

        <property name="hibernate.connection.url">
            jdbc:mysql://localhost:3306/bd_grupo5tp?serverTimezone=America/Argentina/Buenos_Aires
        </property>

        <property name="hibernate.connection.username">
            root
        </property>

        <property name="hibernate.connection.password">
            root
        </property>

        <!-- Dialecto -->
        <property name="hibernate.dialect">
            org.hibernate.dialect.MySQL8Dialect
        </property>

        <!-- Mostrar SQL -->
        <property name="hibernate.show_sql">
            true
        </property>

        <!-- Crear/actualizar las tablas según los mapeos -->
        <property name="hibernate.hbm2ddl.auto">
            update
        </property>

        <!-- Mapeos -->
        <mapping resource="mapeos/DetallePedido.hbm.xml"/>
        <mapping resource="mapeos/Empleado.hbm.xml"/>
        <mapping resource="mapeos/Festival.hbm.xml"/>
        <mapping resource="mapeos/Pedido.hbm.xml"/>
        <mapping resource="mapeos/Plato.hbm.xml"/>
        <mapping resource="mapeos/UnidadVenta.hbm.xml"/>

    </session-factory>

</hibernate-configuration>
